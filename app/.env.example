# Copy to .env and fill in. .env is git-ignored.

# Google Gemini API key (required from Chunk 1 onward)
GOOGLE_API_KEY=

# Secret used to sign JWT session tokens (required from Chunk 2 onward)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=8

# Guardrail token ceiling (Chunk 6)
TOKEN_LIMIT=120000

# Seed login account (Chunk 2)
APP_USERNAME=admin
APP_PASSWORD=change-me

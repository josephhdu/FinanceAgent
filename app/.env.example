# Copy to .env and fill in. .env is git-ignored.

# Google Gemini API key (required)
GOOGLE_API_KEY=

# Secret used to sign JWT session tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=8

# Guardrail input-token ceiling
TOKEN_LIMIT=120000

# Seed login account, created on first boot (add more via scripts/add_user.py)
APP_USERNAME=admin
APP_PASSWORD=change-me
